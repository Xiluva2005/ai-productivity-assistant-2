def llm_call(prompt, system="You are a helpful workplace assistant"):
    # If API key provided, call real model, else return demo
    if api_key:
        try:
            from openai import OpenAI
            client = OpenAI(api_key=api_key)
            resp = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[{"role":"system","content":system},{"role":"user","content":prompt}],
                temperature=0.4
            )
            return resp.choices[0].message.content
        except Exception as e:
            return f"API Error: {e} - Showing Demo Output below.\n\n" + demo_output(prompt)
    else:
        return demo_output(prompt)

